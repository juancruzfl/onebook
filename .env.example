# Copy to .env.local (git-ignored). Everything is optional.

# NEAR Intents 1Click JWT (https://partners.near-intents.org). Without it 1Click adds a small extra fee.
ONECLICK_JWT=

# Polygon RPC used to read the USDC balance at the user's derived address. Optional: tried first, before
# the public fallbacks in src/lib/orders/engine.ts.
POLYGON_RPC_URL=

# Per-order execution cap in USD while this is a demo (default 10). Keep in sync with MAX_EXEC_USD in
# src/components/TradePanel.tsx.
MAX_ORDER_USD=10

# Per-deposit cap for "Add funds" (trading balance), default MAX_ORDER_USD. Never raise without approval.
MAX_FUND_USD=10

# Order queue database (default .data/onebook.db) and worker switch ("off" disables the 5s worker).
ONEBOOK_DB=
ONEBOOK_WORKER=

# ---- Live orders on regulated venues (off by default) ----
# Lets users trade Kalshi and Polymarket US from their OWN accounts. Each user connects their own API keys
# in the browser; keys stay there and never reach this server. This server only plans orders and relays
# browser-signed Kalshi requests.
ONEBOOK_LIVE_ORDERS=off
# Per-order cap in USD for live orders (default 10). Never raise without the human's approval.
MAX_LIVE_USD=10
