# Copy to .env.local (git-ignored). Everything is optional.

# NEAR Intents 1Click JWT (https://partners.near-intents.org). Without it 1Click adds a small extra fee.
ONECLICK_JWT=

# Polygon RPC used to read the USDC balance at the user's derived address (defaults to viem's public RPC).
POLYGON_RPC_URL=

# Per-order execution cap in USD while this is a demo (default 10). Keep in sync with MAX_EXEC_USD in
# src/components/TradePanel.tsx.
MAX_ORDER_USD=10

# Order queue database (default .data/onebook.db) and worker switch ("off" disables the 5s worker).
ONEBOOK_DB=
ONEBOOK_WORKER=

# ---- Live orders on regulated venues (your OWN accounts; off by default) ----
# Sends real fill-or-kill orders to Kalshi and Polymarket US from the trade panel. Only accepted on
# localhost: run the dev server with `npm run dev -- -H 127.0.0.1` when this is on.
ONEBOOK_LIVE_ORDERS=off
# Per-order cap in USD for live orders (default 10). Never raise without the human's approval.
MAX_LIVE_USD=10
# Kalshi API key (kalshi.com → Account → API keys). Private key as a file path or inline PEM.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_PRIVATE_KEY=
# Polymarket US API key (polymarket.us/developer, after identity verification).
PMUS_KEY_ID=
PMUS_SECRET_KEY=
